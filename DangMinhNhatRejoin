import threading
import time

# --- Cau hinh danh sach file can dong bo tu GitHub ---
CONFIG_TARGETS = [
    {
        "file_path": "/storage/emulated/0/Delta/Workspace/SpeedHubX/Save System/Grow A Garden 2/config.json",
        "url": "https://raw.githubusercontent.com/dangnhat588-source/GAG2/refs/heads/main/config",
        "name": "Grow A Garden 2"
    },
    {
        "file_path": "/storage/emulated/0/Delta/Workspace/SpeedHubX/Save System/StealAnEgg/config.json",
        "url": "https://raw.githubusercontent.com/dangnhat588-source/SAE/refs/heads/main/config",
        "name": "Steal An Egg"
    }
]

SYNC_INTERVAL = 1  # Chu ky kiem tra file (giay)

# --- Cau hinh cho phan Auto-Restart (Rejoin) ---
DOWNLOAD_DIR = "/storage/emulated/0/Download"
FOLDER_NAME = os.path.join(DOWNLOAD_DIR, "DMN_Tool")
CONFIG_FILE = os.path.join(FOLDER_NAME, "accounts.txt")

RESTART_INTERVAL = 39999999600
SEQUENTIAL_DELAY = 10


def check_and_fix_file_loop():
    """Luong chay ngam: Quet va cap nhat danh sach các file config lien tuc moi 1 giay."""
    session = requests.Session()

    while True:
        for target in CONFIG_TARGETS:
            file_path = target["file_path"]
            url = target["url"]
            name = target["name"]

            dir_name = os.path.dirname(file_path)
            if not os.path.exists(dir_name):
                try:
                    os.makedirs(dir_name, exist_ok=True)
                    print(f"[+] [Sync] Da tao thu muc cho {name}: {dir_name}")
                except Exception as e:
                    print(f"[!] [Sync] Loi khi tao thu muc {name}: {e}")

            try:
                response = session.get(url, timeout=5)
                if response.status_code == 200:
                    sample_content = response.text.strip()

                    current_content = ""
                    if os.path.exists(file_path):
                        try:
                            with open(file_path, "r", encoding="utf-8") as f:
                                current_content = f.read().strip()
                        except Exception:
                            pass

                    if current_content != sample_content:
                        print(
                            f"\n[⚡] [Sync] Phat hien file config ({name}) bi thay doi!"
                            " Dang dong bo lai tu GitHub..."
                        )
                        with open(file_path, "w", encoding="utf-8") as f:
                            f.write(response.text)
                        print(f"[+] [Sync] Da cap nhat file ({name}) thanh cong!\n")
                else:
                    print(
                        f"[!] [Sync - {name}] GitHub tra ve ma loi: {response.status_code}"
                    )

            except Exception:
                pass

        time.sleep(SYNC_INTERVAL)


def ensure_config_exists():
    """Tudong tao thu muc DMN_Tool va file accounts.txt neu chua co."""
    if not os.path.exists(FOLDER_NAME):
        try:
            os.makedirs(FOLDER_NAME, exist_ok=True)
            print(f"[+] Da tao thu muc quan ly: {FOLDER_NAME}")
        except Exception as e:
            print(f"[!] Loi khi tao thu muc {FOLDER_NAME}: {e}")

    if not os.path.exists(CONFIG_FILE):
        try:
            sample_data = (
                "# Format: package_name = link_server HOAC package_name, link_server\n"
                "# Vi du:\n"
                "# com.roblox.client = https://www.roblox.com/games/...\n"
            )
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                f.write(sample_data)
            print(f"[+] Da tao file mau: {CONFIG_FILE}")
            print("[!] Vui long them danh sach tai khoan/package vao file tren roi chay lai tool!")
        except Exception as e:
            print(f"[!] Loi khi tao file {CONFIG_FILE}: {e}")


def load_accounts():
    accounts = {}
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue

                if "," in line:
                    parts = line.split(",", 1)
                elif "=" in line:
                    parts = line.split("=", 1)
                else:
                    continue

                pkg = parts[0].strip()
                link = parts[1].strip()
                pkg = pkg.split()[0]

                if pkg and link:
                    accounts[pkg] = link
    return accounts


def kill_and_open_tab(pkg, server_link):
    print(f"\n[🔄] Xu ly goi: {pkg}")

    print(f"[-] Dang tat hoan toan ung dung {pkg}...")
    os.system(f"su -c 'am force-stop {pkg}'")
    time.sleep(3)

    print(f"[+] Dang mo lai app {pkg} kem link server...")
    cmd = (
        "su -c 'am start -W -a android.intent.action.VIEW -d"
        f' "{server_link}" {pkg}\''
    )
    os.system(cmd)

    time.sleep(2)
    print(f"[+] Da hoan tat mo lai cho {pkg}")


def main():
    print("==========================================")
    print("   TOOL AUTO-RESTART DMN & SYNC CONFIG")
    print("==========================================")

    # Kich hoat luong dong bo ngam
    sync_thread = threading.Thread(target=check_and_fix_file_loop, daemon=True)
    sync_thread.start()
    print("[🚀] Da kich hoat luong tu dong kiem tra & dong bo file config (1s/lan).\n")

    # Kiem tra va tao file accounts.txt neu chua co
    ensure_config_exists()

    accounts = load_accounts()
    if not accounts:
        print(
            f"[!] File {CONFIG_FILE} chua co tai khoan nao. Vui long dien thông tin va chay lai."
        )
        return

    print(f"[-] Dang tai tong cong {len(accounts)} goi ung dung...")
    print(f"[-] Thu muc quan ly: {FOLDER_NAME}\n")

    print("[*] Bat dau mo lan luot tung tab ban dau (Delay 10s moi tab)...")
    for index, (pkg, server_link) in enumerate(accounts.items(), 1):
        print(f"\n--- Tab {index}/{len(accounts)} ---")
        kill_and_open_tab(pkg, server_link)

        if index < len(accounts):
            print(
                f"[*] Dang doi {SEQUENTIAL_DELAY} giay de tab load link server..."
            )
            time.sleep(SEQUENTIAL_DELAY)
        else:
            time.sleep(3)

    print(
        "\n[+] Da khoi dong xong toan bo cac tab! Chuyen sang che do dem gio Rejoin dinh ky...\n"
    )

    timer_restart = {pkg: time.time() for pkg in accounts.keys()}

    loop_count = 0
    while True:
        accounts = load_accounts()
        current_time = time.time()

        loop_count += 1
        if loop_count >= 30:
            current_time_str = time.strftime("%H:%M:%S")
            print(
                f"[*] [{current_time_str}] Tool dang chay ngam dem gio cho {len(accounts)} goi..."
            )
            loop_count = 0

        for pkg, server_link in list(accounts.items()):
            if pkg not in timer_restart:
                timer_restart[pkg] = current_time
                continue

            if current_time - timer_restart[pkg] >= RESTART_INTERVAL:
                print(f"\n[⏰] Den lich lam moi (Rejoin) cho goi {pkg}.")
                kill_and_open_tab(pkg, server_link)

                timer_restart[pkg] = time.time()
                print(f"[+] Da hoan tat lenh Rejoin dinh ky cho {pkg}\n")

                time.sleep(3)

        for pkg in list(timer_restart.keys()):
            if pkg not in accounts:
                del timer_restart[pkg]

        time.sleep(10)


if __name__ == "__main__":
    main()
