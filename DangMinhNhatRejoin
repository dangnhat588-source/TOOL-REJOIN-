local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

local BLACKLIST_URL = "https://raw.githubusercontent.com/dangnhat588-source/TOOL-REJOIN-/refs/heads/main/nhinconcac"
local OFFSET_Y = 40 
local SCAN_INTERVAL = 60
local MAX_EMPTY_SCANS = 5

local noTargetCount = 0
local stopped = false

local function getBlacklist()
	local success, result = pcall(function()
		return game:HttpGet(BLACKLIST_URL)
	end)
	
	local t = {}
	if success and result then
		for line in result:gmatch("[^\r\n]+") do
			local trimmed = line:match("^%s*(.-)%s*$")
			if trimmed ~= "" then
				t[trimmed:lower()] = true
			end
		end
	end
	return t
end

local function clickCenter()
	local size = camera.ViewportSize
	local x, y = size.X / 2, (size.Y / 2) + OFFSET_Y
	VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
	task.wait(0.05)
	VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function processTarget(p, blacklist)
	if p ~= LocalPlayer then
		local name = p.Name:lower()
		local dName = p.DisplayName:lower()
		local id = tostring(p.UserId)
		
		if blacklist[name] or blacklist[dName] or blacklist[id] then
			pcall(function()
				StarterGui:SetCore("PromptBlockPlayer", p)
			end)
			
			task.wait(2)
			clickCenter()
			task.wait(2)
			return true
		end
	end
	return false
end

task.spawn(function()
	while not stopped do
		local blacklist = getBlacklist()
		local foundAny = false
		
		for _, p in ipairs(Players:GetPlayers()) do
			if processTarget(p, blacklist) then
				foundAny = true
			end
		end
		
		if foundAny then
			noTargetCount = 0
		else
			noTargetCount = noTargetCount + 1
			if noTargetCount >= MAX_EMPTY_SCANS then
				stopped = true
				break
			end
		end
		
		task.wait(SCAN_INTERVAL)
	end
end)

Players.PlayerAdded:Connect(function(newPlayer)
	if stopped then return end
	task.wait(2)
	local blacklist = getBlacklist()
	if processTarget(newPlayer, blacklist) then
		noTargetCount = 0
	end
end)

